PORT=4000
CLIENT_ORIGIN=http://localhost:5173
PUBLIC_APP_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/formforge
# Optional database override used to isolate ephemeral preview environments.
# MONGODB_DATABASE=formforge_preview_pr_123
SESSION_TTL_HOURS=12
PASSWORD_RESET_TTL_MINUTES=30
EMAIL_VERIFICATION_TTL_MINUTES=60
REQUIRE_TRANSACTIONAL_EMAIL=false
TRIAL_MAX_FORMS_PER_ACCOUNT=25
TRIAL_MAX_PUBLISHED_FORMS_PER_ACCOUNT=5
# Optional inputs for `npm run seed:demo --workspace server`.
# DEMO_USER_NAME=FormForge Demo
# DEMO_USER_EMAIL=demo@example.com
# DEMO_USER_PASSWORD=choose-a-private-password
# Configure a verified sender to deliver password-reset and email-verification links through Amazon SES.
# PASSWORD_RESET_FROM_EMAIL=formforge@example.com
