PORT=4000
CLIENT_ORIGIN=http://localhost:5173
PUBLIC_APP_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/formforge
SESSION_TTL_HOURS=12
PASSWORD_RESET_TTL_MINUTES=30
